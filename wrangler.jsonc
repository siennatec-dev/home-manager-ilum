{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-manager-ilum",
  "main": "src/worker.js",
  // >= 2024-09-02 habilita portas customizadas (:9090) no fetch()
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "HM_BASE": "http://300504.homemanager.com.br:9090"
  },
  // Cenas, agendamentos e personalização compartilhados entre aparelhos
  "kv_namespaces": [
    { "binding": "CONFIG", "id": "aae2266d45954f3a985c9c5bc063cb8f" }
  ],
  // Verifica os agendamentos a cada minuto (1.440 execuções/dia)
  "triggers": { "crons": ["* * * * *"] }
  // PIN opcional (recomendado): npx wrangler secret put APP_PIN
}
